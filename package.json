{
  "name": "essenly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:data": "vite-node scripts/audit-places.ts",
    "audit:data:check": "vite-node scripts/audit-places.ts --check",
    "audit:data:merge": "vite-node scripts/merge-place-audit-batches.ts",
    "collect:daiso-data": "vite-node --script scripts/collect-daiso-seoul.ts",
    "build:daiso-data": "vite-node --script scripts/build-daiso-places.ts",
    "build:daiso-ranking": "vite-node --script scripts/build-daiso-ranking.ts",
    "verify:predeploy": "npm run typecheck && npm run lint && npm test && npm run audit:data:check && npm run build",
    "build:subway-data": "node scripts/fetch-subway-sources.mjs && node scripts/build-subway-data.mjs",
    "build:subway-svg": "node scripts/fetch-subway-sources.mjs && node scripts/build-subway-svg.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.26.0",
    "lucide-static": "^1.26.0",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-zoom-pan-pinch": "^4.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "cheerio": "^1.2.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.23",
    "pg": "^8.23.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.14",
    "typescript": "^5",
    "vitest": "^3.2.6",
    "xlsx": "^0.18.5"
  }
}
